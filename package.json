{
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:prisma && npx tsc",
    "build:production": "npm run build:prisma && rm -r ./out; npx tsc --sourceMap false",
    "build:prisma": "prisma generate",
    "run": "node ./out",
    "deploy": "sftp -b deploy.bat raspi"
  },
  "devDependencies": {
    "@types/async-lock": "^1.1.5",
    "@types/node": "^24.13.3",
    "prisma": "^5.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.2.0",
    "async-lock": "^1.3.2",
    "discord.js": "^14.18.0",
    "openai": "^4.12.1"
  }
}
